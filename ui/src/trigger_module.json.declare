                                                                        "__TYPE":"Array",
                                                                        "contents":{
                                                                        }
                                                                    },
                                                                    "tips":""
                                                                },
                                                                "value":"角色：老板|对话：“发布当天，我们将同步上线全网版本，如果一切顺利，每人都有奖金。”（投影屏幕上闪出“目标：ZERO BUG 发布”几个大字。）|场景：早晨 · 公司办公室"
                                                            },
                                                            {
                                                                "ElementName":"Instant",
                                                                "breakPointInfo":{
