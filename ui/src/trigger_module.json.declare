                                                                    "flags":{
                                                                    },
                                                                    "name":"string",
                                                                    "staticWarningMsgs":{
                                                                        "__TYPE":"Array",
                                                                        "contents":{
                                                                        }
                                                                    },
                                                                    "tips":""
                                                                },
                                                                "value":"角色：老板|对话：(老板拍桌鼓励)“这是我们的目标最后调试阶段的目标，大家这几天给我加把劲，别出岔子。只要这次成功，公司就能进下一轮融资，我们都能松口气！”（掌声稀稀拉拉。镜头切至男主。）|场景：早晨 · 公司办公室"
                                                            },
                                                            {
                                                                "ElementName":"Instant",
                                                                "breakPointInfo":{
